# Copy to .env (or run ./scripts/init-env.sh to generate one with random secrets).
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=
JWT_SECRET=                      # 64+ random characters
COOKIE_SECURE=false              # true when served over HTTPS
CORS_ORIGINS=["http://localhost:8080"]
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=        # 12+ chars; only used if no admin exists yet
WEB_PORT=8080
# BINANCE_BASE_URL=https://data-api.binance.vision   # market-data mirror; api.binance.com also works
# BACKUP_KEEP_DAYS=7
